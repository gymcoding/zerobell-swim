---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import AtAGlance from '../components/landing/AtAGlance.astro';
import Timeline from '../components/landing/Timeline.astro';
import Pricing from '../components/landing/Pricing.astro';
import BbqParty from '../components/landing/BbqParty.astro';
import Checklist from '../components/landing/Checklist.astro';
import Faq from '../components/landing/Faq.astro';
import Directions from '../components/landing/Directions.astro';
import FinalCta from '../components/landing/FinalCta.astro';
---

<BaseLayout
  title="제로벨 7시 강습 ⚡ 통일로 원정수영 (6/19 금)"
  description="고기 굽고 🥩 다 같이 단합! 하실 분은 오픈채팅으로 고고~"
  ogTitle="제로벨 7시반 통일로 원정수영 · 초·중·상급 단합 데이 (6/19 금)"
  ogImage="/og.png?v=1"
>
  <!-- ============ HERO ============ -->
  <Hero />

  <main class="px-5 pb-40 -mt-2">
    <!-- ============ 한눈에 보기 ============ -->
    <AtAGlance />

    <!-- ============ 당일 일정 타임라인 ============ -->
    <Timeline />

    <!-- ============ 요금 & 정산 ============ -->
    <Pricing />

    <!-- ============ 이벤트 ============ -->
    <BbqParty />

    <!-- ============ 준비물 ============ -->
    <Checklist />

    <!-- ============ FAQ ============ -->
    <Faq />

    <!-- ============ 오시는 길 / 카풀 ============ -->
    <Directions />

    <!-- ============ 최종 CTA ============ -->
    <FinalCta />

    <footer class="text-center mt-12 font-hand text-[var(--pool)] text-lg">
      제로벨 7시 강습 · 통일로 원정수영 🌊<br>
      <span class="text-sm text-[var(--ink)]/50 font-round">2026. 6. 19 (금)</span>
    </footer>
  </main>

  <!-- ============ STICKY 하단 CTA ============ -->
  <div class="fixed left-1/2 -translate-x-1/2 bottom-0 z-50 w-full max-w-[460px] px-4 pt-2 safe-bottom bg-gradient-to-t from-[var(--cream)] via-[var(--cream)] to-transparent">
    <a href="https://open.kakao.com/o/g188H7vi" rel="noopener"
       class="cta-pulse flex items-center justify-center gap-2 w-full font-round text-lg text-white bg-[var(--coral)] border-[3px] border-[var(--ink)] rounded-full py-3.5 shadow-[3px_4px_0_var(--ink)] active:translate-y-1 active:shadow-[1px_1px_0_var(--ink)] transition-all">
      <span class="text-xl">💬</span> 나도 갈래! 오픈채팅 입장
    </a>
  </div>
</BaseLayout>

<script>
  // ClientRouter(View Transitions) 전환에도 매번 초기화되도록 astro:page-load 사용
  function initLanding() {
    // 버블 생성 (중복 방지)
    const wrap = document.getElementById('bubbles');
    if (wrap && !wrap.dataset.bubbled) {
      wrap.dataset.bubbled = '1';
      const N = 14;
      for (let i = 0; i < N; i++) {
        const b = document.createElement('span');
        b.className = 'bubble';
        const size = 6 + Math.random() * 22;
        b.style.width = b.style.height = size + 'px';
        b.style.left = (Math.random() * 100) + '%';
        b.style.animationDuration = (6 + Math.random() * 7) + 's';
        b.style.animationDelay = (Math.random() * 6) + 's';
        wrap.appendChild(b);
      }
    }
    // 스크롤 등장
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: .12 });
    document.querySelectorAll('.reveal').forEach((el) => {
      if (el.closest('header')) { el.classList.add('in'); return; }
      io.observe(el);
    });
  }
  document.addEventListener('astro:page-load', initLanding);
</script>
