---
import BaseLayout from './BaseLayout.astro';
import AppHeader from '../components/carpool/AppHeader.astro';
import ConfirmModal from '../components/carpool/ConfirmModal.astro';
import Toast from '../components/carpool/Toast.astro';

export interface Props {
  title: string;
  ogTitle?: string;
  ogDescription?: string;
  /** 모바일 헤더 제목(있으면 헤더 표시, 없으면 home처럼 배너 슬롯 사용) */
  headerTitle?: string;
  backHref?: string;
  /** room.ts mount()가 페이지를 구분하는 마커 */
  page: 'home' | 'carpool' | 'shop' | 'status';
}

const { title, ogTitle, ogDescription, headerTitle, backHref = '/room', page } = Astro.props;
const padTop = headerTitle ? 'padding-top:calc(64px + env(safe-area-inset-top));' : '';
---

<BaseLayout title={title} ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/og.png?v=1" wrapperClass="min-h-screen min-h-[100dvh]">
  {headerTitle && <AppHeader title={headerTitle} backHref={backHref} />}

  <slot name="banner" />

  <main data-room-page={page} class="px-5 pb-24" style={padTop}>
    <slot />
  </main>

  <ConfirmModal />
  <Toast />
</BaseLayout>

<script>
  import { mount } from '../lib/room';
  document.addEventListener('astro:page-load', mount);
</script>
